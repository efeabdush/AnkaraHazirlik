# ---------- public site ----------
APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- owner-only ----------
# Generate a long random value and keep it server-side only.
ADMIN_SECRET=

# ---------- AI (paid by the site owner, server-side only) ----------
# Fill ONLY the provider(s) you own. Pick the model from a dropdown in /admin.
#
# OpenCode Go / Zen subscription key: https://opencode.ai/auth
OPENCODE_API_KEY=
# OpenRouter credit: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional fallback: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Startup defaults. The admin panel overrides and remembers these.
LLM_PROVIDER=opencode-go
LLM_MODEL=

# Optional attribution shown on the OpenRouter dashboard
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_NAME=Hazirlik Prep

DATABASE_URL=sqlite:///./storage/hazirlik.db
EXPLAIN_RATE_LIMIT_PER_HOUR=20
EVALUATION_RATE_LIMIT_PER_HOUR=30
COACH_RATE_LIMIT_PER_HOUR=80
TRANSCRIBE_RATE_LIMIT_PER_HOUR=30
AI_DAILY_REQUEST_LIMIT=250
TRANSCRIBE_DAILY_REQUEST_LIMIT=100
TURNSTILE_RATE_LIMIT_PER_HOUR=30
TURNSTILE_DAILY_REQUEST_LIMIT=1000
AI_MAX_CONCURRENT=3
TRANSCRIBE_MAX_CONCURRENT=1
# Production'da rastgele, uzun bir değer kullan; ham IP veritabanına yazılmaz.
RATE_LIMIT_HASH_SECRET=

# İkisi de boşsa Turnstile tamamen kapalıdır. Cloudflare widget anahtarlarını
# backend/Railway değişkenlerine eklediğinde site otomatik doğrulama ister.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SESSION_SECRET=
TURNSTILE_SESSION_MINUTES=30
# Virgülle ayır: frontend-production-07ea.up.railway.app,ornekalanadi.com
TURNSTILE_ALLOWED_HOSTNAMES=

# İletişim formu (Resend). Üçü de doluysa form e-postayı doğrudan iletir.
# CONTACT_FROM_EMAIL için kendi alan adını Resend'de doğruladıktan sonra
# örnek: Ankara Hazırlık <iletisim@ankarahazirlik.com>
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Ankara Hazırlık <onboarding@resend.dev>
CONTACT_RATE_LIMIT_PER_HOUR=5
CONTACT_DAILY_REQUEST_LIMIT=100

# Yerel konuşma algılama. base.en CPU'da dengeli hız/doğruluk sunar.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_WORKER_TIMEOUT_SECONDS=180
MAX_SPEAKING_AUDIO_MB=25
